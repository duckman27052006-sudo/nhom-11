# Sao chép thành deploy/.env rồi sửa các giá trị bên dưới.

# Bắt buộc: IP private của máy chủ mà web gateway sẽ bind.
# Với WireGuard hub có thể là 10.8.0.1; với LAN HQ là 192.168.10.50.
WEB_HOST=192.168.10.50
WEB_PORT=8080

# Bắt buộc: subnet của từng trụ sở, cách nhau bằng dấu phẩy.
ALLOWED_NETWORKS=192.168.10.0/24,192.168.20.0/24

# TFTP chạy cùng host, chỉ nghe loopback.
TFTP_ADDRESS=127.0.0.1:6969
THREADS=8

# Chỉ bật khi phía trước có reverse proxy TLS thật (Caddy/nginx).
# SECURE_COOKIE=1
# TRUSTED_PROXIES=127.0.0.1/32

# Thư mục dữ liệu trên host. Tạo trước và chown cho UID 10001 (xem README).
# Đây là đường dẫn trên host, không phải đường dẫn trong container.
HOST_FILES_DIR=/opt/tftp-chat/files
HOST_DATA_DIR=/opt/tftp-chat/web-data

# Tuỳ chọn: nâng một tài khoản đã đăng ký lên quản trị khi khởi động.
# ADMIN_USER=alice_nguyen
