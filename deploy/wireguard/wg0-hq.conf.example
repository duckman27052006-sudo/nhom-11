# WireGuard tại máy chủ trung tâm (HQ).
# Cài: apt install wireguard; copy thành /etc/wireguard/wg0.conf; chmod 600.
# Sinh khoá:
#   wg genkey | tee hq-private.key | wg pubkey > hq-public.key
#   wg genkey | tee branch-private.key | wg pubkey > branch-public.key
# Điền <...> bằng nội dung khoá tương ứng, KHÔNG commit khoá thật.

[Interface]
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = <HQ_PRIVATE_KEY>

# Giữ nguyên IP nguồn của chi nhánh (192.168.20.x) — không MASQUERADE —
# để ACL --allowed-network phân biệt được client đến từ trụ sở nào.
# Bật forwarding nếu muốn máy khác trong LAN HQ truy cập ngược sang chi nhánh.
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A FORWARD -i %i -j ACCEPT
PostUp = iptables -A FORWARD -o %i -j ACCEPT
PostDown = iptables -D FORWARD -i %i -j ACCEPT
PostDown = iptables -D FORWARD -o %i -j ACCEPT

[Peer]
# Router/VM tại chi nhánh (10.8.0.2) và toàn bộ LAN chi nhánh.
PublicKey = <BRANCH_PUBLIC_KEY>
AllowedIPs = 10.8.0.2/32, 192.168.20.0/24
PersistentKeepalive = 25
